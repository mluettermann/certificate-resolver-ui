# Configuration for certificate-resolver-ui
# Copy this file to ".env" and adjust the values.

# Name of the cert-resolver container controlled via "docker exec".
RESOLVER_CONTAINER=certificate-resolver

# Flask session secret. MUST be changed (e.g. `openssl rand -hex 32`).
# If this value changes, all existing logins become invalid.
SECRET_KEY=change-me

# Send the session cookie only over HTTPS (Secure flag). Set to "true"
# ONLY once the UI is served behind TLS - over plain HTTP the browser
# would drop the cookie and login would not work.
SECURE_COOKIES=false

# Trust the reverse proxy (Traefik) and use X-Forwarded-For for the real
# client IP in the access log. Set false only if exposed directly.
TRUST_PROXY=true
# PROXY_HOPS=1   # number of proxies in front (increase if e.g. Cloudflare -> Traefik)

# Idle session timeout in minutes: users are logged out automatically after
# this much inactivity (default 30).
SESSION_TIMEOUT_MINUTES=30

# Brute-force protection: lock an account after this many failed login/2FA
# attempts (default 5) for this many minutes (default 15).
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Logging: access logs go to rotating files under DATA_DIR; stdout shows
# only status. Optional rotation tuning:
# LOG_MAX_BYTES=10485760   # rotate at 10 MB
# LOG_BACKUPS=5            # keep 5 rotated files

# Initial admin account (only relevant on the very first start).
ADMIN_USERNAME=admin
# Leave empty -> a random password is generated and written to the log once.
# A password change is required on first login in any case.
ADMIN_PASSWORD=

# Central data directory inside the container (default: /data).
# The following are stored underneath automatically:
#   users.json, audit.log, acmedns-credentials.json,
#   cert-targets.yml and certs/
DATA_DIR=/data

# Optional: override individual paths independently of DATA_DIR.
# CERT_DIR=/data/certs
# USERS_FILE=/data/users.json
# AUDIT_FILE=/data/audit.log
# CREDS_FILE=/data/acmedns-credentials.json
# TARGETS_FILE=/data/cert-targets.yml
