# Configuration for certificate-resolver-ui (docker compose)
# Copy this file to ".env" and adjust the values. In Portainer, set them as
# stack environment variables instead.

# ── Shared with the resolver — use the SAME values as there ───────
# Host folder with the resolver's runtime data (certs/, data/, cert-targets.yml).
# The UI keeps its own state in DATA_ROOT/ui-data/.
DATA_ROOT=/opt/certificate-resolver
# Shared host folder for all log files.
LOG_ROOT=/var/log/certificate_resolver
# container_name of the resolver, controlled via "docker exec".
RESOLVER_CONTAINER=certificate-resolver

# ── Web access ───────────────────────────────────────────────────
# Send the session cookie only over HTTPS (Secure flag). Set to "true" when
# the UI runs behind Traefik / Caddy / nginx with TLS (the normal case).
# Keep "false" ONLY for plain-HTTP access (e.g. SSH tunnel to 127.0.0.1:5050)
# - otherwise the browser drops the cookie and login does not work.
SECURE_COOKIES=false

# Trust the reverse proxy and use X-Forwarded-For for the real client IP.
# Set false only if the UI is exposed directly without a proxy.
TRUST_PROXY=true
# PROXY_HOPS=1   # number of proxies in front (increase if e.g. Cloudflare -> Traefik)

# ── Traefik (deploy/traefik/docker-compose.traefik.yml) ───────────
# Public hostname of the UI (router rule Host(`${DOMAIN}`)).
# DOMAIN=cert.example.com
# TRAEFIK_NETWORK=traefik_proxy
# TRAEFIK_ENTRYPOINT=websecure

# ── Proxy as a container (deploy/proxy-network/...) ───────────────
# Name of the existing Docker network your Caddy/nginx container is in.
# PROXY_NETWORK=proxy

# ── Security ─────────────────────────────────────────────────────
# Flask session secret. REQUIRED — the app refuses to start without it or
# with this example value. Generate with: openssl rand -hex 32
# If this value changes, all existing logins become invalid.
SECRET_KEY=change-me

# Idle session timeout in minutes (default 30).
SESSION_TIMEOUT_MINUTES=30

# Brute-force protection: lock an account after this many failed login/2FA
# attempts (default 5) for this many minutes (default 15).
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── Initial admin account (only relevant on the very first start) ─
ADMIN_USERNAME=admin
# Leave empty -> a random password is generated and written to the log once.
# A password change is required on first login in any case.
ADMIN_PASSWORD=

# ── Image version ────────────────────────────────────────────────
# Default "1" = newest 1.x release: fixes and features are picked up (e.g. by
# Watchtower), breaking 2.0 changes are not. Pin an exact release with e.g.
# UI_TAG=1.2.3, or use "edge" for the untested main branch.
# UI_TAG=1
